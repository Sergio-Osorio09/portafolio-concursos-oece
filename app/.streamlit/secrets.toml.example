# Copia este archivo como  app/.streamlit/secrets.toml  y pega UNA clave (Gemini u OpenRouter).
# secrets.toml está en .gitignore: NUNCA lo subas a GitHub ni lo compartas.

# Opción A: OpenRouter (modelos gratuitos). La clave empieza con "sk-or-".
# OPENROUTER_API_KEY = "sk-or-v1-..."
# OPENROUTER_MODEL = "openrouter/free"        # opcional; cualquier modelo terminado en :free

# Opción B: Gemini (Google AI Studio).
GEMINI_API_KEY = "clave_API_gemini"
# GEMINI_MODEL = "gemini-flash-latest"         # opcional
